# Copy to .env for local dev. Never commit .env.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SHORTCODE=
AT_DELIVERY_USERNAME=       # optional 2nd account for the final message to recipients only
AT_DELIVERY_API_KEY=        #   (e.g. tasks on the sandbox, delivery on live); set all 3 or none
AT_DELIVERY_SENDER=         #   bulk sender ID, e.g. AFTKNG
AT_KEYWORD=                 # shared shortcode only, e.g. LUGHA; leave empty for a dedicated one
AT_CALLBACK_TOKEN=          # random string; append ?token=... to the AT callback URLs
DATABASE_URL=sqlite:///./lugha.db
PHONE_ENC_KEY=              # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
PHONE_HASH_SALT=            # random string
ADMIN_TOKEN=                # random string
